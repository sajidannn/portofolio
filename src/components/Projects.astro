---
import { projects } from "../data/project";
---

<section id="work">
    <div class="row">
        <h2 class="section-title reveal">
            My <span class="highlight">Projects</span>
        </h2>

        <div class="work__grid">
            {
                projects.map((project) => (
                    <div class="project-card reveal">
                        <div
                            class="project-card__image"
                            style={`background: url('${project.image}') center/cover;`}
                        />
                        <h3>{project.title}</h3>
                        <p>{project.description}</p>

                        <div class="tech-stack">
                            {project.tags.map((tag) => (
                                <span class="tech-tag">{tag}</span>
                            ))}
                        </div>

                        <div class="project-links">
                            {project.links.journal && (
                                <a
                                    href={project.links.journal}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="icon-link"
                                    title="Journal Article"
                                    aria-label="Journal Article"
                                >
                                    <i data-lucide="book-open" />
                                </a>
                            )}
                            {project.links.live && (
                                <a
                                    href={project.links.live}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="icon-link"
                                    title="Live Site"
                                    aria-label="Live Site"
                                >
                                    <i data-lucide="external-link" />
                                </a>
                            )}
                            {project.links.colab && (
                                <a
                                    href={project.links.colab}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="icon-link"
                                    title="Colab Notebook"
                                    aria-label="Colab Notebook"
                                >
                                    <i data-lucide="code" />
                                </a>
                            )}
                            {project.links.code && (
                                <a
                                    href={project.links.code}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="icon-link"
                                    title="Source Code"
                                    aria-label="Source Code"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="lucide lucide-github"
                                    >
                                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                                        <path d="M9 18c-4.51 2-5-2-7-2" />
                                    </svg>
                                </a>
                            )}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    // 3D Tilt Effect untuk Project Cards
    const cards = document.querySelectorAll(".project-card");
    cards.forEach((card) => {
        const htmlCard = card as HTMLElement;
        htmlCard.addEventListener("mousemove", (e: MouseEvent) => {
            const rect = htmlCard.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const rotateX = ((y - centerY) / centerY) * -5;
            const rotateY = ((x - centerX) / centerX) * 5;

            htmlCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        });

        htmlCard.addEventListener("mouseleave", () => {
            htmlCard.style.transform = `perspective(1000px) rotateX(0) rotateY(0)`;
        });
    });
</script>
